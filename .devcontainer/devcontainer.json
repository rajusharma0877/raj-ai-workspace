{
  "name": "Hermes Agent",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "username": "vscode"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [8642, 9119],
  "portsAttributes": {
    "8642": {
      "label": "Hermes Gateway API",
      "onAutoForward": "notify"
    },
    "9119": {
      "label": "Hermes Dashboard (if enabled)",
      "onAutoForward": "notify"
    }
  },
  "remoteUser": "vscode"
}
